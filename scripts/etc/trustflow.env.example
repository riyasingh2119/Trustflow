# /etc/trustflow/trustflow.env  (owner trustflow, mode 600). Used by the systemd unit.
DB_URL=jdbc:postgresql://10.0.2.10:5432/trustflow
DB_USER=trustflow
DB_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long-please
CORS_ORIGIN=https://your-public-ip-or-domain
DEMO_MODE=false
APP_TZ=Asia/Kolkata
ALERT_URL=
ALERT_KEY=
