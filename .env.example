# Copy to .env (git-ignored) and change every value before any real deployment.
POSTGRES_PASSWORD=change-me-db-password
# At least 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me-0123456789
# Browser origin allowed by CORS (comma separated)
CORS_ORIGIN=http://localhost:8081,http://localhost:5173
# true enables the simulatedHour override and the demo authenticator; set false outside demos
DEMO_MODE=true
APP_TZ=Asia/Kolkata
# Filled in after the CloudFormation stack is created (output AlertUrl); leave empty to log alerts only
ALERT_URL=
ALERT_KEY=
GRAFANA_PASSWORD=change-me-grafana
